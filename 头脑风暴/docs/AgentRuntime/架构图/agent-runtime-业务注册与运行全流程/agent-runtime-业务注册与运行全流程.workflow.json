      { "from": "client", "to": "agent_runner" },
      { "from": "runtime_api", "to": "agent_runner" },
      { "from": "agent_runner", "to": "model_gateway" },
      { "from": "agent_runner", "to": "tool_delivery" }
    ]
  },
  "nodes": [
    { "id": "package_source", "lane": "release", "col": 0, "type": "backend", "label": "不可变 AgentPackage", "sublabel": "workflow / schema / tools", "width": 148 },
