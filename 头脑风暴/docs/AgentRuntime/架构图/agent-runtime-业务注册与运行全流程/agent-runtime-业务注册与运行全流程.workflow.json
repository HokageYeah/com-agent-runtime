    { "id": "agent_registry", "lane": "release", "col": 3, "type": "database", "label": "AgentDefinition 注册", "sublabel": "version / digest / active", "width": 154 },
    { "id": "client", "lane": "business", "col": 0, "type": "frontend", "label": "用户端", "sublabel": "访问业务 API", "width": 136 },
    { "id": "business_system", "lane": "business", "col": 1, "type": "backend", "label": "业务 API + 事实库", "sublabel": "权限、快照、作品 / 工单", "width": 164 },
    { "id": "business_worker", "lane": "business", "col": 2, "type": "messagebus", "label": "业务 Runtime Worker", "sublabel": "快照 / outbox / 绑定启动", "width": 158 },
    { "id": "runtime_api", "lane": "runtime_control", "col": 2, "type": "security", "label": "Runtime API + Admission", "sublabel": "HMAC / 幂等 / 精确版本", "width": 164 },
    { "id": "runtime_store", "lane": "runtime_control", "col": 3, "type": "database", "label": "Runtime 权威状态库", "sublabel": "Run / Plan / outbox / lease", "width": 164 },
    { "id": "worker_executor", "lane": "runtime_execution", "col": 2, "type": "backend", "label": "Worker + Executor", "sublabel": "dispatch / fencing / checkpoint", "width": 164 },
    { "id": "agent_runner", "lane": "runtime_execution", "col": 3, "type": "backend", "label": "Agent Runner 扩展", "sublabel": "当前：MemoirNodeRunner", "width": 156 },
    { "id": "model_gateway", "lane": "governed_io", "col": 2, "type": "cloud", "label": "ModelGateway", "sublabel": "route / permit / cost / usage", "width": 156 },
    { "id": "tool_delivery", "lane": "governed_io", "col": 3, "type": "security", "label": "Tool / Callback ↔ 业务", "sublabel": "connector / 发布 / 对账", "width": 160 }
  ],
  "edges": [
    { "id": "author_package", "from": "package_source", "to": "package_validate", "label": "新版本目录", "variant": "default", "role": "main" },
    { "id": "register_definition", "from": "package_validate", "to": "agent_registry", "label": "幂等注册", "variant": "security", "role": "main" },
    { "id": "registry_admission", "from": "agent_registry", "to": "runtime_api", "label": "精确版本准入", "variant": "security", "role": "branch" },
    { "id": "user_goal", "from": "client", "to": "business_system", "label": "创建业务目标", "variant": "default", "role": "main" },
    { "id": "enqueue_business", "from": "business_system", "to": "business_worker", "label": "事务：快照 + outbox", "variant": "emphasis", "role": "main" },
    { "id": "held_create", "from": "business_worker", "to": "runtime_api", "label": "HMAC：held → bind → start", "variant": "security", "role": "main" },
    { "id": "freeze_run", "from": "runtime_api", "to": "runtime_store", "label": "Run + Plan + outbox", "variant": "emphasis", "role": "main" },
    { "id": "dispatch_claim", "from": "runtime_store", "to": "worker_executor", "label": "outbox + lease/fencing", "variant": "emphasis", "role": "main" },
    { "id": "select_runner", "from": "worker_executor", "to": "agent_runner", "label": "验 digest → 选 Runner", "variant": "emphasis", "role": "main" },
    { "id": "call_model", "from": "agent_runner", "to": "model_gateway", "label": "受预算治理的模型调用", "variant": "default", "role": "branch" },
    { "id": "call_business_tools", "from": "agent_runner", "to": "tool_delivery", "label": "Tool + callback outbox", "variant": "security", "role": "main" }
  ]
}
