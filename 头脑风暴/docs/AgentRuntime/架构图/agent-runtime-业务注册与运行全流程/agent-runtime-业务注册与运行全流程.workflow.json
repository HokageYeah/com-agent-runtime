{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AgentRuntime：从 AgentPackage 发布到业务交付",
    "locale": "zh-CN",
    "animation": "none",
    "quality_profile": "showcase",
    "views": [
      { "id": "package-release", "label": "1. Package 发布注册", "focus": ["package_source", "package_validate", "agent_registry", "runtime_api"], "note": "不可变 agent_id@version 经 CI 验证、digest 校验和管理员注册后，才能被 Admission 使用。" },
      { "id": "business-onboarding", "label": "2. 业务接入与启动", "focus": ["client", "business_system", "business_worker", "runtime_api", "runtime_store"], "note": "业务先冻结自己的快照，再 held create、绑定 run_id、start，避免孤儿 Run 和跨网络持锁。" },
      { "id": "runtime-core", "label": "3. Runtime 公共核心", "focus": ["runtime_api", "runtime_store", "worker_executor", "model_gateway", "tool_delivery"], "note": "Run、Plan、outbox、lease/fencing、预算、checkpoint、模型与工具治理可被不同业务 Agent 复用。" },
      { "id": "agent-extension", "label": "4. 业务 Agent 扩展点", "focus": ["agent_registry", "agent_runner", "business_system", "model_gateway", "tool_delivery"], "note": "每个新 Agent 需要自己的 Package、Runner 接线、业务工具 connector 和授权配置。" },
      { "id": "result-return", "label": "5. 发布与可靠回传", "focus": ["agent_runner", "tool_delivery", "business_system", "runtime_store"], "note": "业务工具负责原子发布；Runtime 通过 callback outbox 送状态，业务可主动查询补偿。" }
    ],
    "output": "agent-runtime-业务注册与运行全流程.html"
  },
  "lanes": [
    { "id": "release", "label": "01 / AgentPackage 开发、发布与注册" },
    { "id": "business", "label": "02 / 用户与业务系统（业务事实源）" },
    { "id": "runtime_control", "label": "03 / 公共 AgentRuntime 控制面" },
    { "id": "runtime_execution", "label": "04 / 公共执行骨架 + Agent 扩展" },
    { "id": "governed_io", "label": "05 / 模型、业务工具与可靠回传" }
  ],
  "phases": [
    { "id": "author", "label": "定义与触发", "fromCol": 0, "toCol": 1 },
    { "id": "admit", "label": "校验、注册与准入", "fromCol": 2, "toCol": 2, "variant": "security" },
    { "id": "execute", "label": "持久化、执行与交付", "fromCol": 3, "toCol": 3, "variant": "emphasis" }
  ],
  "groups": [
    { "id": "common_control", "label": "通用公共底座", "lane": "runtime_control", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "common_execution", "label": "通用执行器", "lane": "runtime_execution", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "business_extension", "label": "Agent 专属扩展", "lane": "runtime_execution", "fromCol": 3, "toCol": 3, "variant": "dashed" },
    { "id": "governance", "label": "受治理外部 I/O", "lane": "governed_io", "fromCol": 2, "toCol": 3, "variant": "security" }
  ],
  "mainPath": ["client", "business_system", "business_worker", "runtime_api", "runtime_store"],
