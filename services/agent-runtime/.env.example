ENVIRONMENT=development
DATABASE_URL=sqlite:///./agent_runtime.db
REDIS_URL=redis://localhost:6379/0
RUNTIME_ID=agent-runtime
AGENT_PACKAGE_ROOT=./app/agents
CALLBACK_ALLOWED_HOSTS=couple-diary.internal
TRUSTED_CLIENTS_JSON={"couple-diary":{"tenant_id":"couple-diary"}}
SIGNATURE_TOLERANCE_SECONDS=300
RUN_QUEUE_NAME=agent-runtime-runs
MODEL_TRAFFIC_NAMESPACE=agent-runtime:model-traffic
MODEL_PERMIT_TTL_SECONDS=90
AUDIT_RETENTION_DAYS=180
AUDIT_ALLOWED_ROLES=runtime_auditor
