# 作为模板（不包含敏感信息）
# 环境设置
ENVIRONMENT=development

# CORS 配置
# 支持逗号分隔，也支持 JSON 数组字符串。
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 请求日志配置
REQUEST_ID_HEADER=X-Request-ID
SLOW_REQUEST_THRESHOLD_MS=800

# 开发环境数据库
DEV_DB_DRIVER=mysql+mysqlconnector
DEV_DB_USER=your_mysql_user
DEV_DB_PASSWORD=your_mysql_password
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_NAME=couple_diary_agent_runtime_dev
DEV_DB_CHARSET=utf8mb4
DEV_DB_ECHO=True
DEV_DB_POOL_SIZE=5
DEV_DB_MAX_OVERFLOW=10
DEV_DB_POOL_RECYCLE=3600
DEV_DB_POOL_TIMEOUT=30

# 生产环境数据库
PROD_DB_DRIVER=mysql+mysqlconnector
PROD_DB_USER=your_mysql_user
PROD_DB_PASSWORD=your_mysql_password
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_NAME=couple_diary_agent_runtime_prod
PROD_DB_CHARSET=utf8mb4
PROD_DB_ECHO=True
PROD_DB_POOL_SIZE=5
PROD_DB_MAX_OVERFLOW=10
PROD_DB_POOL_RECYCLE=3600
PROD_DB_POOL_TIMEOUT=30

# 测试环境数据库
TEST_DB_DRIVER=mysql+mysqlconnector
TEST_DB_USER=your_mysql_user
TEST_DB_PASSWORD=your_mysql_password
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=couple_diary_agent_runtime_test
TEST_DB_CHARSET=utf8mb4
TEST_DB_ECHO=True
TEST_DB_POOL_SIZE=5
TEST_DB_MAX_OVERFLOW=10
TEST_DB_POOL_RECYCLE=3600
TEST_DB_POOL_TIMEOUT=30

# 回忆录业务 worker 到 AgentRuntime 的服务间连接（请在真实环境替换 secret）
MEMORY_RUNTIME_BASE_URL=http://127.0.0.1:8002
MEMORY_RUNTIME_CLIENT_ID=couple-diary
MEMORY_RUNTIME_KEY_ID=dev
MEMORY_RUNTIME_SECRET=replace_with_service_secret
MEMORY_RUNTIME_TIMEOUT_SECONDS=5
MEMORY_RUNTIME_CAPABILITY_TTL_SECONDS=60
# S3/MinIO/COS 私有媒体桶：五项必须同时配置；真实密钥请放在 .env.local。
MEMORY_MEDIA_S3_ENDPOINT_URL=
MEMORY_MEDIA_S3_BUCKET=
MEMORY_MEDIA_S3_REGION=
MEMORY_MEDIA_S3_ACCESS_KEY_ID=
MEMORY_MEDIA_S3_SECRET_ACCESS_KEY=
MEMORY_MEDIA_SIGNED_URL_TTL_SECONDS=60

# ---- M8 回忆录语音与配乐（默认关闭；本地联调才开启，真实密钥放 .env.development.local）----
# 完整变量矩阵、Key 申请入口与两环境前缀见 ENV_CONFIG.md M8 节。
MEMOIR_AUDIO_ENABLED=false
# 旁白 TTS 独立 Key（豆包语音控制台创建，seed-tts-2.0 资源）。
MEMOIR_TTS_API_KEY=
# 背景音乐复用火山 AK/SK（需开通 imagination 音乐服务），Action 显式配置。
VOLCANO_CV_ACCESS_KEY=
VOLCANO_CV_SECRET_KEY=
MEMOIR_MUSIC_ACTION=
MEMOIR_MUSIC_DOWNLOAD_ALLOWED_HOSTS_JSON=[]
# 音频计费（CNY；单价与单 Run 预算上限，未知不得填 0）。
MEMOIR_AUDIO_COST_CURRENCY=
MEMOIR_TTS_PRICE_PER_1000_TEXT_WORDS=
MEMOIR_MUSIC_PRICE_PER_SECOND=
MEMOIR_AUDIO_MAX_COST_PER_RUN=
# 音频私有 OSS 与对象键前缀（本地开发使用测试前缀）。
MEMORY_AUDIO_OSS_ENDPOINT=
MEMORY_AUDIO_OSS_BUCKET=
MEMORY_AUDIO_OSS_ACCESS_KEY_ID=
MEMORY_AUDIO_OSS_ACCESS_KEY_SECRET=
MEMORY_AUDIO_NARRATOR_PREFIX=memoir-test/audios/narrator/
MEMORY_AUDIO_BACKGROUND_PREFIX=memoir-test/audios/background/
MEMORY_AUDIO_SCOPE_HMAC_KEY=
# 账本输入指纹 HMAC 密钥（Runtime 专属，启用音频时必填；与上面 scope 密钥域隔离不得复用）。
MEMOIR_AUDIO_INPUT_HMAC_KEY=
