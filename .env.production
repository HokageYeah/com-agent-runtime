# ============================================================
# AgentRuntime 生产环境本地部署配置
# 本文件包含生产凭据，禁止提交、截图、上传或复制到工单。
# 推荐生产平台使用 secret manager 注入，而不是长期保留本文件。
# 配置完成后执行：chmod 600 .env.production.local
# ============================================================

# -------------------- 应用运行配置 --------------------

# [必须配置/固定值] 当前运行环境。
ENVIRONMENT=production

# [必须配置/固定值]
# 应用运行在宿主机：127.0.0.1
# 应用运行在 Docker：改成 0.0.0.0
HOST=127.0.0.1

# [必须配置/固定值] 生产 API 监听端口。
PORT=8011

# [必须配置/安全要求] 生产必须关闭调试模式。
DEBUG=false

# [必须配置/安全要求] 生产必须关闭自动重载。
RELOAD=false

# [可选] 生产日志级别。
LOGGING_LEVEL=INFO

# [必须配置/手动填写]
# 填写真实前端 HTTPS 域名，多个域名使用逗号分隔。
# 禁止使用 *。
BACKEND_CORS_ORIGINS=

# [必须配置/固定值] 请求 ID 响应头。
REQUEST_ID_HEADER=X-Request-ID

# [可选] 慢请求阈值，单位为毫秒。
SLOW_REQUEST_THRESHOLD_MS=800

# -------------------- MySQL 应用连接 --------------------

# [必须配置/固定值] SQLAlchemy MySQL 驱动。
DB_DRIVER=mysql+mysqlconnector
# 生产默认禁止应用账号建库；仅首次受控 bootstrap 临时改为 true。
DB_AUTO_CREATE=false

# [必须配置/手动填写] 生产数据库最小权限账号。
# 不允许使用 root。
DB_USER=runtime_prod

# [必须配置/敏感值] runtime_prod 的数据库密码。
DB_PASSWORD=

# [必须配置/按部署方式选择]
# 应用在宿主机运行：127.0.0.1
# 应用在 Docker 运行：改为 Compose 的 MySQL service 名，例如 mysql
DB_HOST=127.0.0.1

# [必须配置/按部署方式选择]
# 应用在宿主机运行：3307
# 应用在 Docker 运行：3306
DB_PORT=3307

# [必须配置/固定值] 生产数据库名，必须由 DBA 或部署平台预先创建。
# AgentRuntime 生产专库，不得改回正在运行的 couple_diary_prod。
DB_NAME=couple_diary_agent_runtime_prod

# [必须配置/固定值] 数据库字符集。
DB_CHARSET=utf8mb4

# [必须配置/安全要求] 生产禁止输出 SQL。
DB_ECHO=false

# [可选] 生产数据库连接池。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# -------------------- Docker MySQL 初始化 --------------------

# [条件必填/敏感值] MySQL 容器 root 密码。
MYSQL_ROOT_PASSWORD=

# [条件必填/固定值] MySQL 容器初始化数据库。
MYSQL_DATABASE=couple_diary_agent_runtime_prod

# [条件必填/固定值] MySQL 容器初始化应用账号。
MYSQL_USER=runtime_prod

# [条件必填/敏感值] MYSQL_USER 对应密码，通常与 DB_PASSWORD 一致。
MYSQL_PASSWORD=

# -------------------- Redis 与共享流控 --------------------

# [必须配置/按部署方式选择]
# 应用在宿主机运行：
RUNTIME_REDIS_URL=redis://127.0.0.1:6380/15

# 应用也在 Docker 运行时，将上一行改成：
# RUNTIME_REDIS_URL=redis://redis:6379/15
#
# 如果 Redis 启用了认证，使用部署 secret manager 注入带认证的 URL，
# 不要把 Redis 密码提交到仓库。

# -------------------- Runtime 基础治理 --------------------

# [必须配置/固定值] 生产 Runtime 服务身份。
RUNTIME_ID=agent-runtime-production

# [必须配置/安全要求] 只有审计表已持久化且访问受控时才能设置 true。
RUNTIME_AUDIT_SINK_CONFIGURED=true

# [必须配置/安全默认] 未完成 exporter 隐私治理前保持 false。
RUNTIME_EXTERNAL_EXPORTER_ENABLED=false

# [条件必填] 只有启用外部 exporter 时填写。
RUNTIME_EXTERNAL_EXPORTER_DATA_CLASSIFICATION=
RUNTIME_EXTERNAL_EXPORTER_SAMPLED_FIELDS=
RUNTIME_EXTERNAL_EXPORTER_REGION=
RUNTIME_EXTERNAL_EXPORTER_RETENTION_DAYS=0
RUNTIME_EXTERNAL_EXPORTER_AUDIT_PERMISSION=
RUNTIME_EXTERNAL_EXPORTER_PRIVACY_PURGE_SUPPORTED=false

# [必须配置/固定值] HMAC 请求时间容差。
RUNTIME_SIGNATURE_TOLERANCE_SECONDS=300

# [必须配置/手动确认] 根据生产容量调整 Runtime admission 上限。
RUNTIME_ADMISSION_MAX_HELD=100
RUNTIME_ADMISSION_MAX_QUEUED=500
RUNTIME_ADMISSION_MAX_RUNNING=50

# -------------------- 生产服务地址与密钥 --------------------

# [必须配置/手动填写]
# 必须填写经过 allowlist 的真实 HTTPS API 地址，例如：
# SERVICE_BASE_URL=https://api.example.com
# 禁止使用 localhost、私网地址或在 URL 中携带凭据。
SERVICE_BASE_URL=

# [必须配置/手动填写]
# 业务后端（couple-diary-b）服务地址：Runtime 的 connector 工具调用与 callback
# 都指向业务后端，不是 Runtime 自己的地址。必须是经过 allowlist 的真实 HTTPS 地址，
# 例如：BUSINESS_SERVICE_BASE_URL=https://business.example.com
BUSINESS_SERVICE_BASE_URL=

# [必须配置/敏感值] couple-diary 与 Runtime 双向共用的生产 client HMAC 密钥。
# 由 secret manager 生成并注入。业务侧 MEMORY_RUNTIME_SECRET 与 Runtime 出站
# connector/callback 都用同一值验签（B9/B10 冻结对称合同），
# 因此不再有独立的 tool secret。
RUNTIME_CLIENT_HMAC_SECRET=

# -------------------- Runtime 入站调用方注册表 --------------------

# [必须配置/自动关联]
# client ID、key ID、授权列表和 client secret 均由部署治理层固定。
RUNTIME_TRUSTED_CLIENTS_JSON='{"couple-diary":{"tenant_id":"couple-diary","keys":{"production-v1":"${RUNTIME_CLIENT_HMAC_SECRET}"},"agent_ids":["memoir_agent"],"business_types":["couple_memory"],"callback_target_ids":["memory_callback"],"connector_ids":["couple_diary_backend"],"data_domains":["couple_memory"],"authorization_version":1,"model_data_residency":"private"}}'

# -------------------- Runtime 工具与 callback --------------------

# [必须配置/自动关联]
# provider、URL 和密钥不得由业务请求、Package 或 prompt 覆盖。
# runtime_id/secret 必须与业务侧 MEMORY_RUNTIME_CLIENT_ID/MEMORY_RUNTIME_SECRET
# 完全对称（B9 冻结合同：业务侧校验 X-Agent-Runtime-Id == MEMORY_RUNTIME_CLIENT_ID）。
RUNTIME_BUSINESS_CONNECTORS_JSON='{"couple_diary_backend":{"enabled":true,"base_url":"${BUSINESS_SERVICE_BASE_URL}","runtime_id":"couple-diary","key_id":"production-v1","secret":"${RUNTIME_CLIENT_HMAC_SECRET}"}}'

# [必须配置/自动关联]
# callback URL 必须是固定 HTTPS 地址，并且不得包含凭据；
# 路径必须是业务侧 B10 实际路由 /api/v1/internal/memory-callbacks，
# runtime_id/secret 同样与业务侧 MEMORY_RUNTIME_* 对称（B10 冻结合同）。
RUNTIME_CALLBACK_TARGETS_JSON='{"memory_callback":{"enabled":true,"url":"${BUSINESS_SERVICE_BASE_URL}/api/v1/internal/memory-callbacks","runtime_id":"couple-diary","key_id":"production-v1","secret":"${RUNTIME_CLIENT_HMAC_SECRET}"}}'

# [必须配置/自动关联]
# 必须与 connector/callback 使用同一个 RUNTIME_CLIENT_HMAC_SECRET。
MEMORY_TOOL_TRUSTED_RUNTIMES_JSON='{"agent-runtime-production":{"keys":{"production-v1":"${RUNTIME_CLIENT_HMAC_SECRET}"}}}'

# -------------------- 回忆录调用 Runtime --------------------

# [必须配置/自动关联] 必须与 SERVICE_BASE_URL 一致。
MEMORY_RUNTIME_BASE_URL=${SERVICE_BASE_URL}

# [必须配置/固定值] 必须存在于 trusted clients 注册表。
MEMORY_RUNTIME_CLIENT_ID=couple-diary

# [必须配置/固定值] 必须存在于 couple-diary.keys。
MEMORY_RUNTIME_KEY_ID=production-v1

# [必须配置/自动关联] 必须与 production-v1 的 client secret 一致。
MEMORY_RUNTIME_SECRET=${RUNTIME_CLIENT_HMAC_SECRET}

# [必须配置/安全默认] Runtime HTTP 超时秒数。
MEMORY_RUNTIME_TIMEOUT_SECONDS=5

# [必须配置/安全默认] capability 缓存秒数。
MEMORY_RUNTIME_CAPABILITY_TTL_SECONDS=60

# -------------------- Snapshot 加密与用户 JWT --------------------

# [必须配置/敏感值]
# 生产 Fernet key 必须由 secret manager 保存。
# 轮换前必须保留旧 key 的解密过渡能力。
MEMORY_SNAPSHOT_FERNET_KEY=

# [必须配置/敏感值]
# 必须与登录签发端使用相同的 JWT secret。
USER_AUTH_JWT_SECRET=

# [必须配置/手动确认] 必须与 JWT 签发端 issuer 一致。
USER_AUTH_JWT_ISSUER=couple-diary

# -------------------- 模型路由 --------------------

# [可选/安全默认]
# [] 表示生产暂不调用真实模型。
# 启用时必须填写经过审批的 provider/model/HTTPS endpoint/驻留/预算/限流配置。
MODEL_ROUTES_JSON=[]

# [条件必填]
# 启用模型后填写逻辑节点到受信 route_id 的映射。
MEMOIR_MODEL_NODE_ROUTES_JSON={}

# -------------------- 私有媒体桶 --------------------

# [条件必填]
# 五项全部为空表示媒体能力关闭。
# 一旦启用，必须全部填写，并使用私有桶和最小权限账号。
MEMORY_MEDIA_S3_ENDPOINT_URL=
MEMORY_MEDIA_S3_BUCKET=
MEMORY_MEDIA_S3_REGION=
MEMORY_MEDIA_S3_ACCESS_KEY_ID=
MEMORY_MEDIA_S3_SECRET_ACCESS_KEY=

# [可选/安全默认] 媒体签名 URL 有效期，最长不建议超过 300 秒。
MEMORY_MEDIA_SIGNED_URL_TTL_SECONDS=60
