# 服务器 production 模板：复制到仓库外的 0600 私有文件，替换所有 change_me/example。
COMPOSE_PROJECT_NAME=com-agent-runtime-production
ENVIRONMENT=production
MEMOIR_INTEGRATION_NETWORK=memoir-integration-production
RUNTIME_ENV_FILE=/usr/HokageYeah/服务端系统/env/runtime-production.env
RUNTIME_API_HOST_PORT=18003
RUNTIME_WORKER_ID=agent-runtime-worker-production
AGENT_PACKAGE_VERSION=1.0.4

DB_DRIVER=mysql+mysqlconnector
DB_AUTO_CREATE=false
DB_HOST=change_me_runtime_prod_mysql_host
DB_PORT=3306
DB_NAME=couple_diary_agent_runtime_prod
DB_USER=runtime_prod
DB_PASSWORD=change_me_runtime_prod_db_password
DB_CHARSET=utf8mb4
DB_ECHO=false
RUNTIME_REDIS_URL=redis://change_me_runtime_prod_redis_host:6379/0

RUNTIME_ID=agent-runtime-production
RUNTIME_AUDIT_SINK_CONFIGURED=true
RUNTIME_EXTERNAL_EXPORTER_ENABLED=false
RUNTIME_TOOL_CONNECTOR_ALLOW_PRIVATE_ENDPOINTS=false
BACKEND_CORS_ORIGINS=https://change-me-runtime.example.com
DEBUG=false

# HMAC secret 必须与情侣日记 production 的 CD_MEMORY_RUNTIME_SECRET 完全一致。
RUNTIME_TRUSTED_CLIENTS_JSON={"couple-diary":{"tenant_id":"couple-diary","keys":{"production-v1":"change_me_runtime_prod_hmac_secret"},"agent_ids":["memoir_agent"],"business_types":["couple_memory"],"callback_target_ids":["memory_callback"],"connector_ids":["couple_diary_backend"],"data_domains":["couple_memory"],"authorization_version":1,"model_data_residency":"private"}}
RUNTIME_BUSINESS_CONNECTORS_JSON={"couple_diary_backend":{"enabled":true,"base_url":"https://change-me-business.example.com","runtime_id":"couple-diary","key_id":"production-v1","secret":"change_me_runtime_prod_hmac_secret"}}
RUNTIME_CALLBACK_TARGETS_JSON={"memory_callback":{"enabled":true,"url":"https://change-me-business.example.com/api/v1/internal/memory-callbacks","runtime_id":"couple-diary","key_id":"production-v1","secret":"change_me_runtime_prod_hmac_secret"}}
MEMORY_TOOL_TRUSTED_RUNTIMES_JSON={"agent-runtime-production":{"keys":{"production-v1":"change_me_runtime_prod_hmac_secret"}}}
MEMORY_RUNTIME_BASE_URL=https://change-me-runtime.example.com
MEMORY_RUNTIME_CLIENT_ID=couple-diary
MEMORY_RUNTIME_KEY_ID=production-v1
MEMORY_RUNTIME_SECRET=change_me_runtime_prod_hmac_secret
MEMORY_SNAPSHOT_FERNET_KEY=change_me_runtime_prod_fernet_key
USER_AUTH_JWT_SECRET=change_me_runtime_prod_jwt_secret
USER_AUTH_JWT_ISSUER=couple-diary

MODEL_ROUTES_JSON=[]
MEMOIR_MODEL_NODE_ROUTES_JSON={}
MODEL_PROVIDER_API_KEYS_JSON={}
MEMOIR_MEDIA_ENABLED=false
