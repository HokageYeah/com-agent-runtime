# ============================================================
# AgentRuntime 测试环境本地配置
# 文件包含数据库密码、HMAC、JWT 和加密密钥，禁止提交到 Git。
# 配置完成后执行：chmod 600 .env.test.local
# ============================================================

# -------------------- 应用运行配置 --------------------

# [必须配置/固定值] 当前运行环境。
ENVIRONMENT=test

# [必须配置/固定值] 测试进程运行在宿主机时监听回环地址。
HOST=127.0.0.1

# [必须配置/固定值] 测试环境 API 端口。
PORT=8010

# [必须配置/安全默认] 测试环境不输出调试上下文。
DEBUG=false

# [必须配置/安全默认] 测试环境关闭自动重载。
RELOAD=false

# [可选] 日志级别。
LOGGING_LEVEL=INFO

# [必须配置/手动确认] 测试前端 CORS 白名单。
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# [必须配置/固定值] 请求 ID 响应头。
REQUEST_ID_HEADER=X-Request-ID

# [可选] 慢请求阈值，单位为毫秒。
SLOW_REQUEST_THRESHOLD_MS=800

# -------------------- MySQL 应用连接 --------------------

# [必须配置/固定值] SQLAlchemy MySQL 驱动。
DB_DRIVER=mysql+mysqlconnector
# AgentRuntime 专库缺失时自动创建；程序会拒绝 couple_diary_test 业务库。
DB_AUTO_CREATE=true

# [必须配置/手动填写] 测试数据库账号。
# 推荐创建只拥有 couple_diary_agent_runtime_test 权限的 runtime_test 账号。
DB_USER=runtime_test

# [必须配置/敏感值] runtime_test 的数据库密码。
DB_PASSWORD=

# [必须配置/固定值] 应用运行在宿主机时使用 127.0.0.1。
DB_HOST=127.0.0.1

# [必须配置/固定值] 测试 MySQL 宿主机端口。
DB_PORT=3306

# [必须配置/固定值] 测试数据库名；缺库时由 DB_AUTO_CREATE 决定是否自动创建。
# AgentRuntime 测试专库，不得改回正在运行的 couple_diary_test。
DB_NAME=couple_diary_agent_runtime_test

# [必须配置/固定值] 数据库字符集。
DB_CHARSET=utf8mb4

# [必须配置/安全默认] 禁止输出 SQL 参数。
DB_ECHO=false

# [可选] 数据库连接池配置。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# -------------------- Docker MySQL 初始化 --------------------

# [条件必填/敏感值] MySQL 容器 root 密码。
MYSQL_ROOT_PASSWORD=

# [条件必填/固定值] MySQL 容器初始化数据库。
MYSQL_DATABASE=couple_diary_agent_runtime_test

# [条件必填/固定值] MySQL 容器初始化应用账号。
MYSQL_USER=runtime_test

# [条件必填/敏感值] MYSQL_USER 对应密码，通常与 DB_PASSWORD 一致。
MYSQL_PASSWORD=

# -------------------- Redis 与共享流控 --------------------

# [必须配置/固定值] 测试环境使用独立 Redis DB 14。
RUNTIME_REDIS_URL=redis://127.0.0.1:6379/14

# -------------------- Runtime 基础治理 --------------------

# [必须配置/固定值] 测试 Runtime 身份。
RUNTIME_ID=agent-runtime-test

# [必须配置/固定值] 审计持久化已经配置。
RUNTIME_AUDIT_SINK_CONFIGURED=true

# [必须配置/安全默认] 测试环境禁止外部 exporter。
RUNTIME_EXTERNAL_EXPORTER_ENABLED=false
RUNTIME_EXTERNAL_EXPORTER_DATA_CLASSIFICATION=
RUNTIME_EXTERNAL_EXPORTER_SAMPLED_FIELDS=
RUNTIME_EXTERNAL_EXPORTER_REGION=
RUNTIME_EXTERNAL_EXPORTER_RETENTION_DAYS=0
RUNTIME_EXTERNAL_EXPORTER_AUDIT_PERMISSION=
RUNTIME_EXTERNAL_EXPORTER_PRIVACY_PURGE_SUPPORTED=false

# [必须配置/固定值] HMAC 时间容差，单位为秒。
RUNTIME_SIGNATURE_TOLERANCE_SECONDS=300

# [可选] Runtime admission 上限。
RUNTIME_ADMISSION_MAX_HELD=100
RUNTIME_ADMISSION_MAX_QUEUED=500
RUNTIME_ADMISSION_MAX_RUNNING=50

# -------------------- 服务地址与安全密钥 --------------------

# [必须配置/固定值] 测试环境 Runtime API 自身地址（供业务侧调用 Runtime）。
SERVICE_BASE_URL=http://127.0.0.1:8010

# [必须配置/固定值] 业务后端（couple-diary-b）服务地址。
# Runtime 的 connector 工具调用与 callback 都指向业务后端，不是 Runtime 自己；
# 测试环境业务后端默认监听 127.0.0.1:8008。
BUSINESS_SERVICE_BASE_URL=http://127.0.0.1:8008

# [必须配置/固定值] 本机双进程测试联调逃生门：connector 指向 loopback 时需显式
# 放行 ToolGateway 的私网 endpoint 校验（仅 development/test 允许开启）。
RUNTIME_TOOL_CONNECTOR_ALLOW_PRIVATE_ENDPOINTS=true

# [必须配置/敏感值] couple-diary 与 Runtime 双向共用的 client HMAC 密钥。
# 业务侧 MEMORY_RUNTIME_SECRET 与 Runtime 出站 connector/callback 都用同一值
# 验签（B9/B10 冻结对称合同），因此不再有独立的 tool secret。
RUNTIME_CLIENT_HMAC_SECRET=

# -------------------- Runtime 安全注册表 --------------------

# [必须配置/自动关联] client secret 必须与 MEMORY_RUNTIME_SECRET 一致。
RUNTIME_TRUSTED_CLIENTS_JSON='{"couple-diary":{"tenant_id":"couple-diary","keys":{"test-v1":"${RUNTIME_CLIENT_HMAC_SECRET}"},"agent_ids":["memoir_agent"],"business_types":["couple_memory"],"callback_target_ids":["memory_callback"],"connector_ids":["couple_diary_backend"],"data_domains":["couple_memory"],"authorization_version":1,"model_data_residency":"private"}}'

# [必须配置/自动关联] connector 是 Runtime 调用业务后端的出站通道；
# runtime_id/secret 必须与业务侧 MEMORY_RUNTIME_CLIENT_ID/MEMORY_RUNTIME_SECRET
# 完全对称（B9 冻结合同：业务侧校验 X-Agent-Runtime-Id == MEMORY_RUNTIME_CLIENT_ID）。
RUNTIME_BUSINESS_CONNECTORS_JSON='{"couple_diary_backend":{"enabled":true,"base_url":"${BUSINESS_SERVICE_BASE_URL}","runtime_id":"couple-diary","key_id":"test-v1","secret":"${RUNTIME_CLIENT_HMAC_SECRET}"}}'

# [必须配置/自动关联] callback 指向业务侧 B10 实际路由 /api/v1/internal/memory-callbacks；
# runtime_id/secret 同样与业务侧 MEMORY_RUNTIME_* 对称（B10 冻结合同）。
RUNTIME_CALLBACK_TARGETS_JSON='{"memory_callback":{"enabled":true,"url":"${BUSINESS_SERVICE_BASE_URL}/api/v1/internal/memory-callbacks","runtime_id":"couple-diary","key_id":"test-v1","secret":"${RUNTIME_CLIENT_HMAC_SECRET}"}}'

# [必须配置/自动关联] 业务端信任的 Runtime 身份；密钥与 client secret 保持一致。
MEMORY_TOOL_TRUSTED_RUNTIMES_JSON='{"agent-runtime-test":{"keys":{"test-v1":"${RUNTIME_CLIENT_HMAC_SECRET}"}}}'

# -------------------- 回忆录调用 Runtime --------------------

# [必须配置/自动关联] Runtime API 地址。
MEMORY_RUNTIME_BASE_URL=${SERVICE_BASE_URL}

# [必须配置/固定值] Runtime client ID。
MEMORY_RUNTIME_CLIENT_ID=couple-diary

# [必须配置/固定值] Runtime client key ID。
MEMORY_RUNTIME_KEY_ID=test-v1

# [必须配置/自动关联] Runtime client HMAC 密钥。
MEMORY_RUNTIME_SECRET=${RUNTIME_CLIENT_HMAC_SECRET}

# [必须配置/安全默认] HTTP 超时和 capability 缓存秒数。
MEMORY_RUNTIME_TIMEOUT_SECONDS=5
MEMORY_RUNTIME_CAPABILITY_TTL_SECONDS=60

# -------------------- Snapshot 加密与用户 JWT --------------------

# [必须配置/敏感值] 测试 Snapshot Fernet 密钥。
MEMORY_SNAPSHOT_FERNET_KEY=

# [必须配置/敏感值] 测试用户 JWT 验签密钥。
USER_AUTH_JWT_SECRET=

# [必须配置/固定值] JWT issuer。
USER_AUTH_JWT_ISSUER=couple-diary

# -------------------- 模型路由 --------------------

# [可选/安全默认] 空数组关闭真实模型请求。
MODEL_ROUTES_JSON=[]

# [可选/安全默认] 不映射任何回忆录模型节点。
MEMOIR_MODEL_NODE_ROUTES_JSON={}

# -------------------- 私有媒体桶 --------------------

# [条件必填] 五项全空表示媒体能力关闭；启用时必须全部配置。
MEMORY_MEDIA_S3_ENDPOINT_URL=
MEMORY_MEDIA_S3_BUCKET=
MEMORY_MEDIA_S3_REGION=
MEMORY_MEDIA_S3_ACCESS_KEY_ID=
MEMORY_MEDIA_S3_SECRET_ACCESS_KEY=

# [可选/安全默认] 签名 URL 有效期秒数。
MEMORY_MEDIA_SIGNED_URL_TTL_SECONDS=60
