# ============================================================
# AgentRuntime 开发环境本地配置
# 文件包含数据库密码、HMAC、JWT 和加密密钥，禁止提交到 Git。
# 配置完成后执行：chmod 600 .env.development.local
# ============================================================

# -------------------- 应用运行配置 --------------------

# [必须配置/固定值] 当前运行环境。
ENVIRONMENT=development

# [必须配置/固定值] API 监听地址。本机运行时只监听回环地址。
HOST=127.0.0.1

# [必须配置/固定值] 开发环境 API 端口。
PORT=8010

# [必须配置/固定值] 是否启用调试模式。建议保持 false，避免输出敏感上下文。
DEBUG=false

# [可选] 开发环境代码变更后是否自动重载。
RELOAD=true

# [可选] 日志级别。不要改成会输出业务正文或模型内容的自定义日志模式。
LOGGING_LEVEL=INFO

# [必须配置/手动确认] 本地前端 CORS 白名单。
# 如果前端使用其他端口，需要把对应地址添加到逗号分隔列表中。
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# [必须配置/固定值] 请求 ID 响应头名称。
REQUEST_ID_HEADER=X-Request-ID

# [可选] 超过该毫秒数的请求被标记为慢请求。
SLOW_REQUEST_THRESHOLD_MS=800

# -------------------- MySQL 应用连接 --------------------

# [必须配置/固定值] SQLAlchemy MySQL 驱动。
DB_DRIVER=mysql+mysqlconnector

# [必须配置/手动填写] MySQL 应用账号。
# 本地可以暂时使用 root，推荐创建只拥有 couple_diary_dev 权限的独立账号。
DB_USER=root

# [必须配置/敏感值] DB_USER 对应的 MySQL 密码。
DB_PASSWORD=

# [必须配置/固定值] 应用运行在宿主机时使用 127.0.0.1。
DB_HOST=127.0.0.1

# [必须配置/固定值] 本地 MySQL 端口。
DB_PORT=3306

# [必须配置/固定值] 开发环境数据库名，使用前必须预先创建。
DB_NAME=couple_diary_dev

# [必须配置/固定值] 数据库字符集。
DB_CHARSET=utf8mb4

# [必须配置/安全默认] 禁止把 SQL 参数输出到日志。
DB_ECHO=false

# [可选] 数据库基础连接池大小。
DB_POOL_SIZE=5

# [可选] 超出基础连接池后允许临时增加的连接数。
DB_MAX_OVERFLOW=10

# [可选] 连接回收时间，单位为秒。
DB_POOL_RECYCLE=3600

# [可选] 获取数据库连接的最长等待时间，单位为秒。
DB_POOL_TIMEOUT=30

# -------------------- Docker MySQL 初始化 --------------------

# [条件必填/敏感值] 仅在使用 MySQL Docker 容器初始化时需要。
MYSQL_ROOT_PASSWORD=

# [条件必填/固定值] MySQL 容器首次启动时创建的数据库。
MYSQL_DATABASE=couple_diary_dev

# [条件必填/手动填写] MySQL 容器创建的应用账号。
# 如果使用 root，可根据实际 Compose 配置调整。
MYSQL_USER=root

# [条件必填/敏感值] MYSQL_USER 对应的密码。
MYSQL_PASSWORD=

# -------------------- Redis 与共享流控 --------------------

# [必须配置/固定值] AgentRuntime permit、共享冷却和流控使用的 Redis。
# /15 是独立逻辑数据库，不要与生产环境或其他业务共用。
RUNTIME_REDIS_URL=redis://127.0.0.1:6379/15

# -------------------- Runtime 基础治理 --------------------

# [必须配置/固定值] 当前 Runtime 的服务身份。
RUNTIME_ID=agent-runtime-development

# [必须配置/固定值] 声明审计表已经持久化并受到访问控制。
RUNTIME_AUDIT_SINK_CONFIGURED=true

# [必须配置/安全默认] 默认禁止向外部观测系统导出 Runtime 数据。
RUNTIME_EXTERNAL_EXPORTER_ENABLED=false

# [条件必填] 启用外部 exporter 时填写允许导出的数据分级。
RUNTIME_EXTERNAL_EXPORTER_DATA_CLASSIFICATION=

# [条件必填] 启用外部 exporter 时填写允许采样的安全字段。
RUNTIME_EXTERNAL_EXPORTER_SAMPLED_FIELDS=

# [条件必填] 启用外部 exporter 时填写数据驻留区域。
RUNTIME_EXTERNAL_EXPORTER_REGION=

# [条件必填] 启用外部 exporter 时填写保留天数。
RUNTIME_EXTERNAL_EXPORTER_RETENTION_DAYS=0

# [条件必填] 启用外部 exporter 时填写访问审计权限标识。
RUNTIME_EXTERNAL_EXPORTER_AUDIT_PERMISSION=

# [条件必填] exporter 是否支持隐私删除。未启用 exporter 时保持 false。
RUNTIME_EXTERNAL_EXPORTER_PRIVACY_PURGE_SUPPORTED=false

# [必须配置/固定值] HMAC 请求允许的时间偏差，单位为秒。
RUNTIME_SIGNATURE_TOLERANCE_SECONDS=300

# [可选] held 状态最大运行数量。
RUNTIME_ADMISSION_MAX_HELD=100

# [可选] queued 状态最大排队数量。
RUNTIME_ADMISSION_MAX_QUEUED=500

# [可选] running 状态最大并发数量。
RUNTIME_ADMISSION_MAX_RUNNING=50

# -------------------- 服务地址与安全密钥 --------------------

# [必须配置/固定值] 开发环境 API 自身地址。
# 该值同时用于 Runtime adapter、connector 和 callback。
SERVICE_BASE_URL=http://127.0.0.1:8010

# [必须配置/敏感值] 业务服务调用 Runtime 的 client HMAC 密钥。
# 建议使用 openssl rand -hex 32 生成。
RUNTIME_CLIENT_HMAC_SECRET=

# [必须配置/敏感值] Runtime 调用工具和 callback 使用的 HMAC 密钥。
# 必须与上面的 client 密钥不同。
RUNTIME_TOOL_HMAC_SECRET=

# -------------------- Runtime 入站调用方注册表 --------------------

# [必须配置/自动关联]
# keys 中的密钥引用 RUNTIME_CLIENT_HMAC_SECRET。
# client ID、key ID 必须与后面的 MEMORY_RUNTIME_CLIENT_ID/KEY_ID 一致。
RUNTIME_TRUSTED_CLIENTS_JSON='{"couple-diary":{"tenant_id":"couple-diary","keys":{"development-v1":"${RUNTIME_CLIENT_HMAC_SECRET}"},"agent_ids":["memoir_agent"],"business_types":["couple_memory"],"callback_target_ids":["memory_callback"],"connector_ids":["couple_diary_backend"],"data_domains":["couple_memory"],"authorization_version":1,"model_data_residency":"private"}}'

# -------------------- Runtime 工具与 callback --------------------

# [必须配置/自动关联]
# base_url 只能来自可信部署配置，业务请求、Package 和 prompt 不得覆盖。
RUNTIME_BUSINESS_CONNECTORS_JSON='{"couple_diary_backend":{"enabled":true,"base_url":"${SERVICE_BASE_URL}","runtime_id":"agent-runtime-development","key_id":"development-v1","secret":"${RUNTIME_TOOL_HMAC_SECRET}"}}'

# [必须配置/自动关联]
# callback URL 不得包含用户名、密码、token 或其他凭据。
RUNTIME_CALLBACK_TARGETS_JSON='{"memory_callback":{"enabled":true,"url":"${SERVICE_BASE_URL}/api/v1/internal/agent-callbacks/memory","runtime_id":"agent-runtime-development","key_id":"development-v1","secret":"${RUNTIME_TOOL_HMAC_SECRET}"}}'

# [必须配置/自动关联]
# 必须与 connector/callback 使用同一个 RUNTIME_TOOL_HMAC_SECRET。
MEMORY_TOOL_TRUSTED_RUNTIMES_JSON='{"agent-runtime-development":{"keys":{"development-v1":"${RUNTIME_TOOL_HMAC_SECRET}"}}}'

# -------------------- 回忆录调用 Runtime --------------------

# [必须配置/自动关联] 必须与 SERVICE_BASE_URL 一致。
MEMORY_RUNTIME_BASE_URL=${SERVICE_BASE_URL}

# [必须配置/固定值] 必须存在于 RUNTIME_TRUSTED_CLIENTS_JSON。
MEMORY_RUNTIME_CLIENT_ID=couple-diary

# [必须配置/固定值] 必须存在于 couple-diary 的 keys 中。
MEMORY_RUNTIME_KEY_ID=development-v1

# [必须配置/自动关联] 必须与调用方注册表中的 client secret 完全相同。
MEMORY_RUNTIME_SECRET=${RUNTIME_CLIENT_HMAC_SECRET}

# [必须配置/安全默认] Runtime HTTP 请求超时秒数。
MEMORY_RUNTIME_TIMEOUT_SECONDS=5

# [必须配置/安全默认] capability 缓存时间，单位为秒。
MEMORY_RUNTIME_CAPABILITY_TTL_SECONDS=60

# -------------------- Snapshot 加密与用户 JWT --------------------

# [必须配置/敏感值] Snapshot Fernet 加密密钥。
# 必须使用 Fernet.generate_key() 生成，不能填写普通密码。
# 丢失或替换后，使用旧密钥加密的 Snapshot 将无法解密。
MEMORY_SNAPSHOT_FERNET_KEY=

# [必须配置/敏感值] 用户 JWT 验签密钥。
# 必须与 client/tool HMAC 密钥不同。
USER_AUTH_JWT_SECRET=

# [必须配置/固定值] 必须与 JWT 签发端使用的 issuer 一致。
USER_AUTH_JWT_ISSUER=couple-diary

# -------------------- 模型路由 --------------------

# [可选/安全默认] 空数组表示关闭真实模型调用，使用确定性模板降级。
# Provider、model、endpoint、价格和限流只能由可信部署配置提供。
MODEL_ROUTES_JSON=[]

# [可选/安全默认] 回忆录逻辑节点到模型 route_id 的映射。
# MODEL_ROUTES_JSON 为空时保持空对象。
MEMOIR_MODEL_NODE_ROUTES_JSON={}

# -------------------- 私有媒体桶 --------------------

# [条件必填] 以下五项全部为空表示关闭媒体能力。
# 一旦启用，五项必须全部填写，并使用私有桶和受控签名 URL。
MEMORY_MEDIA_S3_ENDPOINT_URL=
MEMORY_MEDIA_S3_BUCKET=
MEMORY_MEDIA_S3_REGION=
MEMORY_MEDIA_S3_ACCESS_KEY_ID=
MEMORY_MEDIA_S3_SECRET_ACCESS_KEY=

# [可选/安全默认] 媒体签名 URL 有效时间，单位为秒。
MEMORY_MEDIA_SIGNED_URL_TTL_SECONDS=60
